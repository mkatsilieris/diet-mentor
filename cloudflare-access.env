# Cloudflare Access settings for the API (read by docker compose, api service).
# Nothing here is secret: the team domain and audience appear in the Access login URL.
# scripts/cloudflare-setup.mjs fills them in when the app is published through Cloudflare Access
# (see README); the Access application of Diet Mentor has its own audience (AUD) tag.
# Empty both values to fall back to e-mail/password login only.
ACCESS_TEAM_DOMAIN=odd-sun-cd0f.cloudflareaccess.com
ACCESS_AUD=ab86160a7b007386f3e25e1e3fce64b77cd2726ef1af6a5cf0abdab89c8ecf62
