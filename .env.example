# Copy to .env and adjust. docker compose reads this file automatically.

# Port exposed on the host. 8082 so that it can live next to Bill Split (8080) and Weather Alert (8081).
WEB_PORT=8082

# Public URL of the app (password reset links, the only allowed CORS origin)
APP_URL=http://localhost:8082

# Internet access through Cloudflare Tunnel (see README). Remove both lines to run on the
# local network only. Token: Zero Trust > Networks > Tunnels > diet-mentor > Configure.
#COMPOSE_PROFILES=internet
#TUNNEL_TOKEN=

# Secret used to sign login tokens. CHANGE THIS on the Raspberry Pi:
#   openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# API log detail: debug | info | warn | error. Logs:  docker compose logs -f api
LOG_LEVEL=info

# Time zone that decides where one day ends and the next begins ("today", weeks, months)
DISPLAY_TZ=Europe/Athens

# Database (internal to docker, no need to change)
POSTGRES_USER=diet
POSTGRES_PASSWORD=diet
POSTGRES_DB=diet

# ---- Web Push (meal reminders, motivation) ----
# Leave empty: a VAPID key pair is generated on first start and kept in the database.
# Set them only to carry the same pair to another installation (web-push generate-vapid-keys).
#VAPID_PUBLIC_KEY=
#VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-reply@example.com

# ---- Optional SMTP for "forgot password" ----
# If left empty the reset link is printed in the api logs:  docker compose logs api
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Diet Mentor <no-reply@example.com>"
